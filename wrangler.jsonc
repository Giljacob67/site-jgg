{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-jgg",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "jgggroup.com.br/*", "zone_name": "jgggroup.com.br" },
    { "pattern": "www.jgggroup.com.br/*", "zone_name": "jgggroup.com.br" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "ratelimits": [{ "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "LEAD_TO": "contato@jgggroup.com.br",
    "LEAD_FROM": "Site JGG Group <site@jgggroup.com.br>",
    "CANONICAL_HOST": "jgggroup.com.br"
  },
  "env": {
    "preview": {
      "name": "site-jgg-agro-premium",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "LEAD_TO": "delivered@resend.dev",
        "CANONICAL_HOST": "site-jgg-agro-premium.jgggroup.workers.dev",
        "LEAD_FROM": "Site JGG Group <site@jgggroup.com.br>"
      },
      "ratelimits": [{ "name": "LEAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }]
    },
    "terra-roxa": {
      "name": "site-jgg-terra-roxa",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "LEAD_TO": "delivered@resend.dev",
        "CANONICAL_HOST": "site-jgg-terra-roxa.jgggroup.workers.dev",
        "LEAD_FROM": "Site JGG Group <site@jgggroup.com.br>"
      },
      "ratelimits": [{ "name": "LEAD_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }]
    }
  },
  "observability": { "enabled": true }
  // Segredos (nunca neste arquivo): wrangler secret put RESEND_API_KEY
  // Opcionais: AUTOMATION_WEBHOOK_URL, AUTOMATION_WEBHOOK_SECRET
  // Domínio real ligado em 18/11/2026 — ver docs/virada-dns.md
}
