---
import { fallbackQuotes, pct } from '../data/market';
---
<section class="market-bar" aria-label="Indicadores do mercado agropecuário">
  <div class="market-label">
    <span class="market-live-dot"></span>
    <div><b>Mercado Agro</b><small>Últimos indicadores</small></div>
    <button type="button" class="market-motion" aria-controls="market-quotes" data-market-motion hidden>Pausar</button>
  </div>
  <div class="market-viewport" id="market-quotes" tabindex="0" aria-label="Cotações em rolagem horizontal" data-market-viewport>
    <div class="market-track">
      <div class="market-quotes" data-market-quotes>
        {fallbackQuotes.map((q) => (
          <div class="market-quote">
            <span>{q.label} <i>{q.region}</i></span>
            <strong>{q.value} <small>{q.unit}</small></strong>
            {q.variation !== null && <b class={q.variation >= 0 ? 'up' : 'down'}>{q.variation >= 0 ? '▲' : '▼'} {pct(q.variation)}%</b>}
            <em>{q.source} · {q.asOf}</em>
          </div>
        ))}
      </div>
    </div>
  </div>
  <a href="/radar" class="market-info">Fontes e contexto →</a>
</section>
<script>
  import { pct, type Quote } from '../data/market';

  const viewport = document.querySelector<HTMLElement>('[data-market-viewport]');
  const quotes = viewport?.querySelector<HTMLElement>('[data-market-quotes]');
  const control = document.querySelector<HTMLButtonElement>('[data-market-motion]');

  if (viewport && quotes && control) setupTicker(viewport, quotes, control);

  function renderQuote(quote: Quote) {
    const card = document.createElement('div');
    card.className = 'market-quote';

    const title = document.createElement('span');
    const region = document.createElement('i');
    region.textContent = quote.region;
    title.append(quote.label, ' ', region);

    const price = document.createElement('strong');
    const unit = document.createElement('small');
    unit.textContent = quote.unit;
    price.append(quote.value, ' ', unit);

    const source = document.createElement('em');
    source.textContent = quote.source + ' · ' + quote.asOf;

    card.append(title, price);
    if (quote.variation !== null) {
      const change = document.createElement('b');
      const rising = quote.variation >= 0;
      change.className = rising ? 'up' : 'down';
      change.textContent = (rising ? '▲ ' : '▼ ') + pct(quote.variation) + '%';
      card.append(change);
    }
    card.append(source);
    return card;
  }

  function setupTicker(viewport: HTMLElement, quotes: HTMLElement, control: HTMLButtonElement) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const hover = matchMedia('(hover: hover)');
    let playing = !reducedMotion.matches;
    const copies: HTMLElement[] = [];
    let frame = 0;
    let lastTime = 0;
    let position = 0;
    let quoteWidth = 0;

    function clearCopies() {
      for (const copy of copies) copy.remove();
      copies.length = 0;
    }

    function advance(time: number) {
      if (lastTime) position = (position + Math.min(time - lastTime, 50) * 0.036) % quoteWidth;
      viewport.scrollLeft = position;
      lastTime = time;
      frame = requestAnimationFrame(advance);
    }

    function updateMotion() {
      cancelAnimationFrame(frame);
      quoteWidth = quotes.offsetWidth;
      const visible = quoteWidth > 0 && viewport.clientWidth > 0;
      control.hidden = !visible;
      control.textContent = playing ? 'Pausar' : 'Mover';
      control.setAttribute('aria-label', playing ? 'Pausar cotações' : 'Mover cotações');
      if (!playing || !visible) {
        clearCopies();
        return;
      }

      const copiesNeeded = Math.ceil(viewport.clientWidth / quoteWidth);
      if (copies.length !== copiesNeeded) {
        clearCopies();
        for (let i = 0; i < copiesNeeded; i++) {
          const copy = quotes.cloneNode(true) as HTMLElement;
          copy.removeAttribute('data-market-quotes');
          copy.setAttribute('aria-hidden', 'true');
          copies.push(copy);
        }
        quotes.after(...copies);
      }
      if (hover.matches && viewport.matches(':hover')) return;
      lastTime = 0;
      position = viewport.scrollLeft % quoteWidth;
      frame = requestAnimationFrame(advance);
    }

    function pause() {
      playing = false;
      updateMotion();
    }

    control.addEventListener('click', () => { playing = !playing; updateMotion(); });
    reducedMotion.addEventListener('change', (event) => { if (event.matches) pause(); });
    viewport.addEventListener('focusin', pause);
    viewport.addEventListener('pointerdown', pause);
    viewport.addEventListener('pointerenter', updateMotion);
    viewport.addEventListener('pointerleave', updateMotion);
    viewport.addEventListener('wheel', (event) => { if (event.deltaX || event.shiftKey) pause(); }, { passive: true });

    let resizeFrame = 0;
    const size = new ResizeObserver(() => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(updateMotion);
    });
    size.observe(viewport);
    size.observe(quotes);

    fetch('/api/market?v=2', { cache: 'no-cache' })
      .then((response) => response.json())
      .then((data: { quotes?: Quote[] }) => {
        if (!data.quotes?.length) return;
        quotes.replaceChildren(...data.quotes.map(renderQuote));
        clearCopies();
        updateMotion();
      })
      .catch(() => undefined);
  }
</script>
