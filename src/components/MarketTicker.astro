---
import { fallbackQuotes, pct } from '../data/market';
---
<section class="market-bar" aria-label="Indicadores do mercado agropecuário"><div class="market-label"><span class="market-live-dot"></span><div><b>Mercado Agro</b><small data-market-status>Últimos indicadores</small></div></div><div class="market-viewport" tabindex="0" aria-label="Cotações disponíveis na horizontal"><div class="market-track" data-market-track>{fallbackQuotes.map((q) => <div class="market-quote"><span>{q.label} <i>{q.region}</i></span><strong>{q.value} <small>{q.unit}</small></strong>{q.variation !== null && <b class={q.variation >= 0 ? 'up' : 'down'}>{q.variation >= 0 ? '▲' : '▼'} {pct(q.variation)}%</b>}<em>{q.source} · {q.asOf}</em></div>)}</div></div><a href="/radar" class="market-info">Fontes e contexto →</a></section>
<script>
  import { pct, type Quote } from '../data/market';
  const track = document.querySelector<HTMLElement>('[data-market-track]');
  const status = document.querySelector<HTMLElement>('[data-market-status]');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  fetch('/api/market')
    .then((r) => r.json())
    .then((d: { quotes?: Quote[] }) => {
      if (!track || !d.quotes?.length) return;
      track.innerHTML = d.quotes
        .map((q) => `<div class="market-quote"><span>${esc(q.label)} <i>${esc(q.region)}</i></span><strong>${esc(q.value)} <small>${esc(q.unit)}</small></strong>${q.variation === null ? '' : `<b class="${q.variation >= 0 ? 'up' : 'down'}">${q.variation >= 0 ? '▲' : '▼'} ${pct(q.variation)}%</b>`}<em>${esc(q.source)} · ${esc(q.asOf)}</em></div>`)
        .join('');
      if (status) status.textContent = 'Indicadores atualizados';
    })
    .catch(() => undefined);
</script>
