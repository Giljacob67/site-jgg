---
import Logo from './Logo.astro';
import SiteNav from './SiteNav.astro';
interface Props { cta: string; href: string }
const { cta, href } = Astro.props;
---
<header class="agro-header terra-roxa">
  <div class="agro-wrap agro-header-inner">
    <a href="/" aria-label="JGG Group — início"><Logo /></a>
    <SiteNav {cta} {href} />
  </div>
</header>
