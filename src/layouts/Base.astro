---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/original.css';
import '../styles/additions.css';
import serif from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sans from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';

export const SITE = 'https://jgggroup.com.br';

interface Props {
  title: string;
  description: string;
  /** Caminho canônico, como "/radar". Omitido em páginas de erro. */
  path?: string;
  noindex?: boolean;
  og?: { title?: string; description?: string; type?: 'website' | 'article'; publishedTime?: string };
  jsonLd?: Record<string, unknown>[];
  preload?: string[];
}

const { title, description, path, noindex = false, og = {}, jsonLd = [], preload = ['/jgg-logo-horizontal.svg'] } = Astro.props;
const canonical = path === undefined ? undefined : path === '/' ? SITE : SITE + path;
const ogType = og.type ?? 'website';
const ogUrl = og.type === 'article' && canonical ? canonical : SITE;

const legalService = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'JGG Group',
  url: SITE,
  email: 'contato@jgggroup.com.br',
  telephone: '+55 44 98833-5397',
  areaServed: ['Paraná', 'Mato Grosso'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Euclides da Cunha, 526',
    addressLocality: 'Maringá',
    addressRegion: 'PR',
    addressCountry: 'BR',
  },
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={og.title ?? 'JGG Group — Agro Radar'} />
    <meta property="og:description" content={og.description ?? 'Inteligência jurídica para decisões no campo.'} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="JGG Group" />
    <meta property="og:type" content={ogType} />
    {og.publishedTime && <meta property="article:published_time" content={og.publishedTime} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="JGG Group — Agro Radar" />
    <meta name="twitter:description" content="Inteligência jurídica para decisões no campo." />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <meta name="theme-color" content="#082c25" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {[serif, serifItalic, sans].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    {preload.map((href) => <link rel="preload" href={href} as="image" />)}
    <script type="application/ld+json" set:html={JSON.stringify(legalService)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
