---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/original.css';
import '../styles/additions.css';
import '../styles/agro-premium.css';
import '../styles/terra-roxa.css';
import serif from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import sans from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import { officePhones } from '../data/office-phones';
import { officeAddress } from '../data/office-address';

export const SITE = 'https://jgggroup.com.br';
export const PREVIEW = import.meta.env.PUBLIC_PREVIEW_ORIGIN ?? 'https://site-jgg-agro-premium.jgggroup.workers.dev';

interface Props {
  title: string;
  description: string;
  /** Caminho canônico, como "/radar". Omitido em páginas de erro. */
  path?: string;
  noindex?: boolean;
  terraRoxa?: boolean;
  og?: { title?: string; description?: string; type?: 'website' | 'article'; publishedTime?: string; image?: string };
  jsonLd?: Record<string, unknown>[];
  preload?: string[];
}

const { title, description, path, noindex = false, terraRoxa = false, og = {}, jsonLd = [], preload = ['/jgg-logo-horizontal.svg'] } = Astro.props;
const canonical = path === undefined ? undefined : path === '/' ? SITE : SITE + path;
const ogType = og.type ?? 'website';
const ogUrl = canonical ?? SITE;
const ogImage = new URL(og.image ?? '/og.png', import.meta.env.MODE === 'preview' ? PREVIEW : SITE).href;

const legalService = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'JGG Group',
  url: SITE,
  email: 'contato@jgggroup.com.br',
  telephone: [officePhones.landline, ...officePhones.mobiles].map(({ number }) => number),
  areaServed: ['Paraná', 'Mato Grosso'],
  address: {
    '@type': 'PostalAddress',
    ...officeAddress,
  },
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={og.title ?? title} />
    <meta property="og:description" content={og.description ?? description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="JGG Group" />
    <meta property="og:type" content={ogType} />
    {og.publishedTime && <meta property="article:published_time" content={og.publishedTime} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og.title ?? title} />
    <meta name="twitter:description" content={og.description ?? description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={terraRoxa ? '#f3ede2' : '#17382c'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {[serif, serifItalic, terraRoxa ? archivo : sans].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    {preload.map((href) => <link rel="preload" href={href} as="image" />)}
    <script type="application/ld+json" set:html={JSON.stringify(legalService)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body class:list={{ 'terra-roxa': terraRoxa }}>
    {import.meta.env.MODE === 'preview' && <p class="agro-preview">Prévia da JGG · Use apenas dados fictícios nos formulários.</p>}
    <slot />
    <script>
      import { preserveCampaignLinks } from '../scripts/campaign.js';
      preserveCampaignLinks(new URL(location.href), document.querySelectorAll('a[href]'));
    </script>
  </body>
</html>
