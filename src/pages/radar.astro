---
import Base from '../layouts/Base.astro';
import SubHeader from '../components/SubHeader.astro';
import { radarCategories } from '../data/radar';
import { getRadar } from '../data/radar-content';

const radar = await getRadar({ includePreview: import.meta.env.MODE === 'preview' });
const digest = import.meta.env.PUBLIC_AGRO_DIGEST_URL?.trim();
const digestChannel = digest && /^https:\/\/www\.whatsapp\.com\/channel\/[A-Za-z0-9]+\/?$/.test(digest) ? digest : undefined;
const filters = ['Todos', ...radarCategories];
---
<Base title="JGG Agro Radar | JGG Group" description="Notícias, decisões e normas do agronegócio selecionadas em fontes oficiais e revisadas pela equipe jurídica." path="/radar">
<main class="subpage">
<SubHeader cta="Iniciar triagem" href="/diagnostico" />
<section class="subpage-hero"><div class="shell"><p class="eyebrow light">JGG Agro Radar</p><h1>O que muda no campo,<br />traduzido para decisão.</h1><p>Notícias, decisões e normas selecionadas em fontes oficiais e revisadas antes da publicação.</p></div></section>
<section class="section shell"><div class="live-status"><i></i> Curadoria jurídica com fontes oficiais</div><div class="filters" role="group" aria-label="Filtrar por tema">{filters.map((c, i) => <button type="button" class={`filter-button ${i === 0 ? 'active' : ''}`} aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c}>{c}</button>)}</div><div class="radar-page-grid"><div class="feed" aria-live="polite">{radar.map((item) => <article class="feed-card" data-category={item.category}><div class="date-block"><span class="tag">{item.category}</span><p>{item.date}</p><small>{item.published ? item.level : "Prévia editorial"}</small></div><div><h2><a href={`/radar/${item.slug}`}>{item.title}</a></h2><p>{item.summary}</p><span class="source-line">{item.source} · Conteúdo informativo</span><a href={`/radar/${item.slug}`} class="feed-read">Ler análise completa →</a></div></article>)}</div><aside class="radar-aside">
  {digestChannel ? <>
    <p class="eyebrow light">JGG Agro Digest</p><h3>Acompanhe as novidades</h3>
    <p>Siga o canal para receber as publicações do Agro Radar.</p>
    <a class="button copper" href={digestChannel}>Acompanhar o JGG Agro Digest</a>
  </> : <>
    <p class="eyebrow light">JGG Agro Alerta</p><h3>Acompanhe a tramitação</h3>
    <p>Veja o estágio da matéria em destaque e consulte as fontes oficiais.</p>
    <a class="button copper" href="/agro-alerta">Ver o Agro Alerta</a>
  </>}
</aside></div></section>
</main>
</Base>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.feed-card')];
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => { x.classList.toggle('active', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      cards.forEach((c) => (c.hidden = f !== 'Todos' && c.dataset.category !== f));
    }),
  );
</script>
