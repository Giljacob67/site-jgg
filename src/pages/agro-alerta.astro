---
import Base from '../layouts/Base.astro';
import SubHeader from '../components/SubHeader.astro';
import ShareLink from '../components/ShareLink.astro';
import { currentAlert as alert } from '../data/agro-alerta';
---
<Base title="Agro Alerta | JGG Group" description="Acompanhe mudanças na legislação e decisões relevantes para o Direito Agrário, com data e fontes oficiais." path="/agro-alerta">
  <main class="subpage">
    <SubHeader />
    <article class="article-page shell">
      <p class="eyebrow">JGG Agro Alerta</p>
      <p class="article-date">{alert.topic} · <time datetime={alert.date}>{alert.dateLabel}</time></p>
      <h1>{alert.title}</h1>
      <p class="article-deck">{alert.description}</p>
      <h2>Situação conferida em {alert.checkedLabel}</h2>
      <p>{alert.status}</p>
      <h2>Principais andamentos</h2>
      <ul>
        {alert.history.map((entry) => <li><time datetime={entry.date}>{entry.label}</time> · {entry.description}</li>)}
      </ul>
      <aside class="article-sources">
        <strong>Fontes oficiais</strong>
        <a href={alert.source}>Consultar tramitação no Congresso Nacional ↗</a>
        <a href={alert.news}>Ler a notícia do Senado ↗</a>
      </aside>
      <div class="article-disclaimer">Conteúdo informativo. Consulte a tramitação para verificar movimentações posteriores à data indicada.</div>
      <ShareLink path="/agro-alerta" />
      <p><a class="agro-text-link" href="/guias/credito-rural-e-garantias">Consultar guia de crédito rural e garantias →</a></p>
    </article>
  </main>
</Base>
