---
import Base, { SITE } from '../../layouts/Base.astro';
import SubHeader from '../../components/SubHeader.astro';
import { authors, authorPath } from '../../data/authors';
import { getRadar } from '../../data/radar-content';

export async function getStaticPaths() {
  const radar = await getRadar();
  return authors.map((profile) => ({
    params: { slug: profile.slug },
    props: {
      profile,
      articles: radar.flatMap((item) => {
        if (item.kind !== 'markdown') return [];
        const roles = [];
        if (item.author === profile.slug) roles.push('Autoria');
        if (item.technicalLead === profile.slug) roles.push('Responsabilidade técnica');
        return roles.length ? [{ item, roles }] : [];
      }),
    },
  }));
}

const { profile, articles } = Astro.props;
const path = authorPath(profile.slug);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: SITE + path,
    image: SITE + profile.portrait.large,
    jobTitle: profile.role,
    worksFor: { '@type': 'Organization', name: 'JGG Group', url: SITE },
  },
};
---

<Base terraRoxa title={profile.name + ' | JGG Insights'} description={profile.description} path={path} jsonLd={[schema]}>
  <main class="subpage">
    <SubHeader />
    <article class="article-page shell editorial-profile">
      <a class="back-link" href="/radar">← Voltar ao JGG Insights</a>
      <div class="profile-intro">
        <img
          src={profile.portrait.src}
          srcset={profile.portrait.src + ' 400w, ' + profile.portrait.large + ' 800w'}
          sizes="(max-width: 620px) 160px, 240px"
          width={profile.portrait.width}
          height={profile.portrait.height}
          alt={'Retrato de ' + profile.name}
          decoding="async"
        />
        <div>
          <h1>{profile.name}</h1>
          <p class="profile-role"><strong>{profile.role}</strong></p>
          <p class="profile-registration">{profile.registration}</p>
          <div class="profile-bio">
            <p><strong>{profile.experience}</strong></p>
            <p>{profile.education}</p>
            {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a href="/#equipe" class="agro-text-link">Ver equipe da JGG <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {articles.length > 0 && (
        <section aria-labelledby="profile-articles">
          <h2 id="profile-articles">Publicações no JGG Insights</h2>
          <ul class="profile-articles">
            {articles.map(({item, roles}) => (
              <li>
                <p class="profile-registration">{roles.join(' · ')} · <time datetime={item.dateIso}>{item.date}</time></p>
                <h3><a href={'/radar/' + item.slug}>{item.title}</a></h3>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </main>
</Base>

<style>
  .profile-intro {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    padding-block: 1.25rem;
    border-bottom: 6px double var(--tinta);
  }
  .profile-intro img { width: 100%; border: 1px solid var(--line); }
  .profile-intro h1 { padding-block: .3rem .65rem; }
  .profile-role { font-size: 1.125rem; }
  .profile-registration { color: var(--terra); font-weight: 600; }
  .profile-bio {
    display: grid;
    gap: .85rem;
    max-width: 68ch;
    margin-block: 1.25rem;
    font-size: clamp(1.125rem, 1.6vw, 1.1875rem);
    line-height: 1.6;
  }
  .profile-articles li { padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .profile-articles h3 {
    font: clamp(1.65rem, 3vw, 2.2rem)/1.15 var(--agro-serif);
    margin-top: .3rem;
  }
  .profile-articles h3 a { text-decoration: underline; text-underline-offset: .16em; }
  @media (max-width: 620px) {
    .profile-intro { grid-template-columns: minmax(0, 1fr); }
    .profile-intro img { max-width: 10rem; }
  }
</style>
