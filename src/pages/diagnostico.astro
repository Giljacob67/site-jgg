---
import Base from '../layouts/Base.astro';
import SubHeader from '../components/SubHeader.astro';
import { questions } from '../data/diagnostico';
const first = questions[0];
---
<Base title="Triagem informativa da operação rural | JGG Group" description="Organize informações sobre crédito, garantias, terra e patrimônio antes de solicitar uma análise profissional." path="/diagnostico">
<main class="subpage">
<SubHeader cta="Agro Radar" href="/radar" />
<div class="diag-wrap" data-diag><p class="eyebrow">Triagem informativa</p><h1 style="font-family:Instrument Serif;font-size:clamp(46px,7vw,72px);line-height:1">Quais pontos da operação precisam ser organizados?</h1><p style="color:var(--muted);line-height:1.7">Responda a cinco perguntas para ver seu panorama informativo. O relatório pode ser baixado sem preencher o formulário de contato.</p>
<details class="diag-example">
  <summary>Ver exemplo do relatório</summary>
  <div class="diag-example-sheet">
    <small>EXEMPLO FICTÍCIO</small>
    <h2>Panorama informativo</h2>
    <p><strong>Cenário preventivo</strong></p>
    <dl><dt>Exemplo de resposta organizada</dt><dd>As parcelas do crédito rural estão em dia.</dd><dt>Próximos pontos a conferir</dt><dd>Reúna as cédulas, os aditivos e os documentos das garantias da operação.</dd></dl>
    <p>Conteúdo informativo. Cada caso exige análise própria.</p>
  </div>
</details><div class="progress" role="progressbar" aria-label="Progresso da triagem" aria-valuemin="0" aria-valuemax={questions.length} aria-valuenow="0"><i style="width:0%"></i></div>
<section class="diag-card" data-step aria-live="polite"><small data-step-count>PERGUNTA 1 DE {questions.length}</small><h2 data-step-q>{first[0]}</h2><div class="choices" data-step-choices>{first[1].map((c, i) => <button type="button" data-i={i}>{c}</button>)}</div><button type="button" class="diag-back-button" data-back hidden>← Rever resposta anterior</button></section>
<div class="diag-complete-grid" data-done hidden><section class="diag-result"><small data-result-score></small><h2 data-result-label></h2><p data-result-text></p><p class="diag-gate-note">Baixe o PDF com as respostas organizadas. O contato com a equipe é opcional.</p><button type="button" class="button copper" data-print>Baixar relatório em PDF →</button><a class="button copper" href="https://wa.me/5544988335397?text=Ol%C3%A1!%20Fiz%20a%20triagem%20informativa%20no%20site%20da%20JGG%20Group%20e%20gostaria%20de%20conversar%20sobre%20os%20pontos%20que%20organizei.">Solicitar contato pelo WhatsApp</a><button type="button" class="diag-restart-button" data-restart>Refazer a triagem</button></section>
<form class="lead-form" data-lead novalidate><div class="lead-form-head"><div><small>CONTATO DIRETO</small><h3>Quer que a JGG analise o próximo passo?</h3></div><span>Responsável: Gilberto</span></div><div class="lead-fields"><label><span>Nome *</span><input name="name" required autocomplete="name" maxlength="120" /></label><label><span>WhatsApp *</span><input name="phone" required autocomplete="tel" inputmode="tel" maxlength="20" placeholder="(00) 00000-0000" /></label><label><span>E-mail *</span><input name="email" type="email" required autocomplete="email" maxlength="160" /></label><label><span>Cidade</span><input name="city" autocomplete="address-level2" maxlength="80" /></label><label><span>UF</span><input name="state" maxlength="2" autocomplete="address-level1" /></label><label><span>Assunto</span><select name="matter"><option selected>Crédito rural</option><option>Contratos agrários</option><option>Terra e regularização</option><option>Fiscalização ambiental</option><option>Sucessão e patrimônio</option><option>Tributário</option><option>Outro assunto</option></select></label><label class="lead-summary"><span>Conte brevemente o que está acontecendo</span><textarea name="summary" rows="4" maxlength="3000"></textarea></label><label class="lead-honeypot" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label></div><label class="lead-consent"><input type="checkbox" name="consent" required /><span>Autorizo o tratamento destes dados para o retorno da JGG Group, conforme a <a href="/privacidade" target="_blank">Política de Privacidade</a>.</span></label><p class="lead-error" role="alert" data-lead-error hidden></p><button class="button electric" data-lead-submit>Enviar para a JGG →</button><small class="lead-destination">Destino: contato@jgggroup.com.br · Atendimento também pelo WhatsApp (44) 98833-5397</small></form>
<div class="lead-success" data-lead-ok hidden><span aria-hidden="true">✓</span><div><h3>Contato enviado.</h3><p>A equipe poderá retornar pelos dados informados.</p><a href="https://wa.me/5544988335397">Falar no WhatsApp →</a></div></div></div>
<a href="/" class="back-link">← Voltar ao início</a></div>
</main>
</Base>

<script>
  import { campaignForLead } from '../scripts/campaign.js';
  import { questions, verdict } from '../data/diagnostico';
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const wrap = $('[data-diag]'), bar = $('.progress'), fill = $('.progress i');
  const step = $('[data-step]'), count = $('[data-step-count]'), q = $('[data-step-q]'), choices = $('[data-step-choices]'), back = $('[data-back]');
  const done = $('[data-done]');
  let picks: number[] = [];

  function show() {
    const i = picks.length, total = questions.length, complete = i >= total;
    fill.style.width = `${Math.min((i / total) * 100, 100)}%`;
    bar.setAttribute('aria-valuenow', String(i));
    wrap.classList.toggle('diag-wrap-complete', complete);
    step.hidden = complete;
    done.hidden = !complete;
    if (complete) {
      const score = picks.reduce((a, b) => a + b, 0), v = verdict(score);
      $('[data-result-score]').textContent = `PANORAMA INFORMATIVO · ${score}/10`;
      $('[data-result-label]').textContent = v.label;
      $('[data-result-text]').textContent = v.text;
      return;
    }
    count.textContent = `PERGUNTA ${i + 1} DE ${total}`;
    q.textContent = questions[i][0];
    choices.replaceChildren(...questions[i][1].map((c, n) => {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = c;
      b.addEventListener('click', () => { picks.push(n); show(); q.focus?.(); });
      return b;
    }));
    back.hidden = i < 1;
  }
  choices.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { picks.push(Number(b.dataset.i)); show(); }));
  back.addEventListener('click', () => { picks.pop(); show(); });
  $('[data-restart]').addEventListener('click', () => { picks = []; resetLead(); show(); });

  const answers = () => picks.map((n, i) => `${questions[i][0]} — ${questions[i][1][n]}`);
  const score = () => picks.reduce((a, b) => a + b, 0);

  // Formulário de contato → /api/leads (Worker envia por e-mail)
  const form = $<HTMLFormElement>('[data-lead]'), err = $('[data-lead-error]'), submit = $<HTMLButtonElement>('[data-lead-submit]'), ok = $('[data-lead-ok]');
  function resetLead() { form.reset(); form.hidden = false; ok.hidden = true; err.hidden = true; }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    err.hidden = true; submit.disabled = true; submit.textContent = 'Enviando…';
    try {
      const data = Object.fromEntries(new FormData(form).entries());
      const s = new URLSearchParams(location.search);
      const res = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          ...data,
          consent: data.consent === 'on',
          diagnosticLabel: verdict(score()).label,
          diagnosticScore: score(),
          diagnosticAnswers: answers(),
          ...campaignForLead(s),
          origin: s.get('origem') ?? document.referrer, persona: s.get('persona') ?? '',
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error ?? 'Não foi possível enviar.');
      form.hidden = true; ok.hidden = false;
    } catch (e) {
      err.textContent = e instanceof Error ? e.message : 'Não foi possível enviar agora.';
      err.hidden = false;
    } finally {
      submit.disabled = false; submit.textContent = 'Enviar para a JGG →';
    }
  });

  // Relatório em PDF gerado no navegador, com o mesmo layout do original
  $('[data-print]').addEventListener('click', async () => {
    const { buildReport } = await import('../scripts/report-pdf');
    const blob = await buildReport({ label: verdict(score()).label, score: score(), answers: answers() });
    const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: 'panorama-jgg.pdf' });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10000);
  });
</script>

<style>
  .diag-example { margin-block: 1rem 1.5rem; }
  .diag-example summary { cursor: pointer; color: #17382c; font-weight: 600; }
  .diag-example-sheet { margin-top: .75rem; padding: 1rem 1.25rem; background: #f7f2e9; border: 1px solid #dbcdb8; }
  .diag-example-sheet h2 { font-size: 1.7rem; margin-block: .25rem; }
  .diag-example-sheet dt { font-weight: 600; }
  .diag-example-sheet dd { margin: 0 0 .7rem; }
  [data-print] { margin-right: .5rem; margin-bottom: .5rem; }
</style>
