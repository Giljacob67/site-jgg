---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import SiteNav from '../components/SiteNav.astro';
import MarketTicker from '../components/MarketTicker.astro';
import ContactForm from '../components/ContactForm.astro';
import { getRadar } from '../data/radar-content';
import { cases } from '../data/jurisprudencia';

const congress = 'https://www.congressonacional.leg.br/materias/medidas-provisorias/-/mpv/175190';
const senate = 'https://www12.senado.leg.br/noticias/materias/2026/11/11/renegociacao-de-dividas-rurais-e-aprovada-pelo-senado-e-vai-a-sancao-presidencial';
const latest = (await getRadar({ includePreview: import.meta.env.MODE === 'preview' })).slice(0, 3);
const areas = [
  ['Direito Agrário', 'Atuação nas relações jurídicas vinculadas à produção rural, à exploração da terra e aos instrumentos específicos do agronegócio.'],
  ['Imobiliário rural', 'Propriedade, posse, documentação de imóveis rurais, regularização fundiária e registros.'],
  ['Ambiental e regulatório', 'CAR, regularização ambiental, licenciamento, autuações e regras aplicáveis à produção rural.'],
  ['Contencioso estratégico', 'Controvérsias administrativas e judiciais envolvendo contratos, crédito, propriedade e garantias.'],
];
const tools = [
  ['Contratos rurais', 'Arrendamento, prazo, aviso e garantias contratuais.', '/ferramentas/arrendamento'],
  ['Pequena propriedade', 'Área do imóvel e módulos fiscais.', '/ferramentas/pequena-propriedade'],
  ['Crédito rural', 'Compare cenários de uma operação de crédito.', '/ferramentas/credito-rural'],
];
---
<Base
  title="JGG Group — Inteligência jurídica para o agronegócio"
  description="Estratégia jurídica para crédito rural, terra, contratos, patrimônio, sucessão e tributação no agronegócio."
  path="/"
  preload={['/jgg-logo-horizontal.svg', '/hero-agro.webp']}
>
<a class="agro-skip" href="#conteudo">Ir para o conteúdo</a>
<div class="agro-home">
  <MarketTicker />
  <div class="agro-cover">
    <header class="agro-header">
      <div class="agro-wrap agro-header-inner">
        <a href="/" aria-label="JGG Group — início"><Logo /></a>
        <SiteNav />
      </div>
    </header>
    <section class="agro-wrap agro-hero" aria-labelledby="hero-title">
      <p class="agro-kicker">Advocacia especializada · Direito Agrário · PR e MT</p>
      <h1 id="hero-title">O campo move o Brasil.<br /><em>O direito protege</em><br /> quem faz acontecer.</h1>
      <p>Estratégia jurídica para quem produz, investe e constrói o futuro do agronegócio.</p>
      <div class="agro-actions">
        <a class="agro-button" href="#agro-alerta">Acompanhe o Agro Alerta <span aria-hidden="true">↗</span></a>
        <a class="agro-button agro-button-outline" href="#solucoes">Conheça nossa atuação</a>
      </div>
    </section>
  </div>

  <main id="conteudo">
    <section class="agro-wrap agro-alert" id="agro-alerta" aria-labelledby="alert-title">
      <div class="agro-alert-heading">
        <p class="agro-kicker">JGG Agro Alerta</p>
        <h2 id="alert-title">As decisões que movimentam o Direito Agrário.</h2>
        <p>Notícias, legislação e julgamentos relevantes, com análises sobre seus impactos para quem produz.</p>
      </div>
      <article class="agro-news">
        <div class="agro-meta"><span>Renegociação de dívidas rurais</span><time datetime="2026-11-11">11 nov 2026</time></div>
        <h3>Senado aprova projeto sobre renegociação de dívidas rurais</h3>
        <p>O projeto de conversão da MP 1.376/2026 trata de linhas de crédito para produtores afetados por eventos climáticos. As mudanças aprovadas incluem a ampliação do público que pode ser atendido.</p>
        <p><strong>Situação em 18/11/2026:</strong> enviado à sanção presidencial, segundo o Congresso Nacional.</p>
        <a class="agro-button" href={senate}>Entenda o que muda <span aria-hidden="true">↗</span></a>
        <p class="agro-source">Fonte oficial: <a href={congress}>tramitação no Congresso Nacional</a>.</p>
      </article>
      <div class="agro-alert-grid">
        <article class="agro-alert-card">
          <h3>Jurisprudência comentada</h3>
          <p>Decisões relevantes para quem produz.</p>
          <a href="#jurisprudencia">Acompanhe as decisões <span aria-hidden="true">→</span></a>
        </article>
        <article class="agro-alert-card">
          <h3>Mudanças na legislação</h3>
          <p>Novas regras e seus possíveis efeitos na atividade rural.</p>
          <a href={congress}>Acompanhe a tramitação <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </section>

    <section class="agro-wrap agro-section" id="agro-radar" aria-labelledby="radar-title">
      <div class="agro-heading">
        <div><p class="agro-kicker">Inteligência para o campo</p><h2 id="radar-title">Agro Radar</h2></div>
        <p>Análises jurídicas, decisões dos tribunais e mudanças legislativas que impactam a atividade rural.</p>
      </div>
      <div class="agro-editorial">
        {latest.map((item, index) => (
          <article class:list={['agro-card', { 'agro-card-featured': index === 0 }]}>
            <div class="agro-meta"><span>{item.category}</span><time datetime={item.dateIso}>{item.date}</time></div>
            <h3><a href={`/radar/${item.slug}`}>{item.title}</a></h3>
            <p>{item.summary}</p>
            <footer><span>{item.published ? item.source : 'Prévia editorial'}</span><a href={`/radar/${item.slug}`}>Ler análise <span aria-hidden="true">↗</span></a></footer>
          </article>
        ))}
      </div>
      <a class="agro-text-link" href="/radar">Ver o acervo do Agro Radar <span aria-hidden="true">→</span></a>
    </section>

    <section class="agro-wrap agro-section agro-divider" id="solucoes" aria-labelledby="practice-title">
      <div class="agro-heading">
        <div><p class="agro-kicker">Áreas de atuação</p><h2 id="practice-title">Direito do campo,<br /><em>por inteiro.</em></h2></div>
        <p>Atuação jurídica dedicada às relações, aos ativos e aos desafios do agronegócio.</p>
      </div>
      <div class="agro-grid agro-practice-grid">
        {areas.map(([title, text]) => <article class="agro-card"><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </section>

    <section class="agro-tools" id="ferramentas" aria-labelledby="tools-title">
      <div class="agro-wrap agro-section">
        <div class="agro-heading">
          <div><p class="agro-kicker">Recursos JGG</p><h2 id="tools-title">Ferramentas para<br /><em>decidir melhor.</em></h2></div>
          <p>Pontos de partida para organizar informações da operação rural.</p>
        </div>
        <div class="agro-grid">
          {tools.map(([title, text, url]) => <a class="agro-card agro-tool" href={url}><h3>{title} <span aria-hidden="true">↗</span></h3><p>{text}</p></a>)}
        </div>
        <div class="agro-actions">
          <a class="agro-button" href="/diagnostico">Iniciar triagem informativa <span aria-hidden="true">↗</span></a>
          <a class="agro-text-link" href="/ferramentas/checklist-credito-rural">Checklist de crédito rural</a>
          <a class="agro-text-link" href="/ferramentas">Todas as ferramentas <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="agro-wrap agro-section" id="jurisprudencia" aria-labelledby="cases-title">
      <div class="agro-heading">
        <div><p class="agro-kicker">Fontes oficiais</p><h2 id="cases-title">Jurisprudência</h2></div>
        <p>Consulte decisões e entendimentos diretamente no Superior Tribunal de Justiça.</p>
      </div>
      <div class="agro-grid">
        {cases.map(({ slug, identifier, title }) => (
          <article class="agro-card"><p class="agro-meta">{identifier} · STJ</p><h3>{title}</h3><a href={`/jurisprudencia#${slug}`}>Ver decisão e fonte <span aria-hidden="true">→</span></a></article>
        ))}
      </div>
    </section>

    <section class="agro-team" id="equipe" aria-labelledby="team-title">
      <div class="agro-wrap agro-section">
        <div class="agro-heading">
          <div><p class="agro-kicker">Quem está ao seu lado</p><h2 id="team-title">Especialistas<br /> no que <em>importa.</em></h2></div>
          <p>Atuação integrada em Direito Agrário, Bancário, Tributário e Patrimonial, com presença no Paraná e em Mato Grosso.</p>
        </div>
        <ul class="agro-grid agro-people">
          <li><strong>Gilberto Jacob</strong><span>Sócio fundador · OAB/PR 17.158</span></li>
          <li><strong>Felipe Ricardo Greczyszn</strong><span>Sócio fundador · OAB/PR 136.387</span></li>
          <li><strong>Reginaldo Greczyszn</strong><span>Sócio residente · Mato Grosso</span></li>
        </ul>
      </div>
    </section>

    <section class="agro-wrap agro-section agro-contact" id="contato" aria-labelledby="contact-title">
      <div>
        <p class="agro-kicker">Contato</p>
        <h2 id="contact-title">O seu próximo passo<br /> <em>merece segurança.</em></h2>
        <p>Maringá — PR<br />Av. Euclides da Cunha, 526</p>
        <p>Atuação no Paraná e em Mato Grosso.</p>
        <div class="agro-actions">
          <a class="agro-text-link" href="mailto:contato@jgggroup.com.br">contato@jgggroup.com.br</a>
          <a class="agro-text-link" href="https://wa.me/5544988335397">WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <ContactForm />
    </section>
  </main>

  <footer class="agro-footer">
    <div class="agro-wrap agro-footer-main">
      <a href="/" aria-label="JGG Group — início"><Logo /></a>
      <p>Estratégia jurídica para quem move o agronegócio.<br />Paraná · Mato Grosso</p>
      <nav aria-label="Rodapé"><a href="/radar">Agro Radar</a><a href="/ferramentas">Ferramentas</a><a href="/diagnostico">Diagnóstico</a><a href="https://www.linkedin.com/company/jgggroup">LinkedIn</a></nav>
    </div>
    <div class="agro-wrap agro-footer-bottom"><span>© JGG Group · OAB/PR 17.158</span><a href="/privacidade">Política de Privacidade</a></div>
  </footer>
</div>
</Base>
