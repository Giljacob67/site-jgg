---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import MobileNav from '../components/MobileNav.astro';
import MarketTicker from '../components/MarketTicker.astro';
import { radar } from '../data/radar';

const risks: [string, string][] = [
  ['Dívida vencida', 'Mapeie contrato, encargos e garantias antes de renegociar.'],
  ['Contrato rural', 'Identifique cláusulas que afetam prazo, preço e patrimônio.'],
  ['Terra irregular', 'Veja quais documentos podem travar crédito, venda ou sucessão.'],
  ['Fiscalização', 'Organize notificação, prazo e documentos antes de responder.'],
  ['Sucessão', 'Comece pelo patrimônio, pela operação e pela governança familiar.'],
];
const latest = radar.slice(0, 3);
const wa = (t: string) => `https://wa.me/5544988335397?text=${encodeURIComponent(t)}`;
---
<Base
  title="JGG Group — Inteligência jurídica para o agronegócio"
  description="Estratégia jurídica para crédito rural, terra, contratos, patrimônio, sucessão e tributação no agronegócio."
  path="/"
  preload={['/jgg-logo-horizontal.svg', '/hero-agro.webp']}
>
<main>
<MarketTicker />
<header class="site-header conversion-header"><a href="/" class="brand official-brand" aria-label="JGG Group — início"><Logo /></a><nav aria-label="Navegação principal"><a href="#solucoes">Soluções</a><a href="/radar">Agro Radar</a><a href="/ferramentas">Ferramentas</a><a href="#equipe">Equipe</a></nav><MobileNav /><a href="/diagnostico" class="header-cta solid">Diagnóstico inicial <span>→</span></a></header>
<section class="conversion-hero"><div class="hero-photo" aria-hidden="true"></div><div class="hero-grid-overlay" aria-hidden="true"></div><div class="shell conversion-hero-grid"><div class="hero-copy motion-up"><div class="hero-kicker"><span>Advocacia estratégica</span><b>PR + MT</b></div><h1 data-hero-title>Clareza jurídica para <em>decisões no campo.</em></h1><p data-hero-text>Crédito, terra, contratos, tributos e sucessão exigem uma leitura conjunta. Organize os pontos relevantes antes da próxima decisão.</p><div class="hero-actions"><a href="/diagnostico" class="button electric">Fazer diagnóstico em 3 minutos <span>→</span></a><a class="button glass" href={wa('Olá! Vim pelo site da JGG Group e quero entender meu cenário.')}>Conversar no WhatsApp</a></div><div class="hero-trust"><div><strong>+30</strong><span>anos de atuação jurídica</span></div><div><strong>PR + MT</strong><span>presença no centro do agro</span></div><div><strong>4 áreas</strong><span>analisadas em conjunto</span></div></div></div><aside class="risk-finder motion-up delay-one"><div class="risk-finder-head"><div><span class="radar-pulse"></span><small>ORIENTADOR DE CENÁRIO</small></div><b>01</b></div><h2>O que mais preocupa você hoje?</h2><div class="risk-chips" role="group" aria-label="Escolha uma preocupação">{risks.map(([label, answer], i) => <button type="button" class={i === 0 ? 'active' : ''} aria-pressed={i === 0 ? 'true' : 'false'} data-answer={answer}>{label}</button>)}</div><div class="risk-answer"><span>PRIMEIRO PASSO</span><p aria-live="polite" data-risk-answer>{risks[0][1]}</p></div><a href="/diagnostico">Ver meu cenário completo <b>→</b></a><small class="risk-disclaimer">Ferramenta informativa · sem envio de dados</small></aside></div><div class="scroll-cue"><span>Explore</span><i></i></div></section>
<section class="intent-dock" aria-label="Atalhos por situação"><div class="shell intent-dock-grid"><strong>O que está acontecendo?</strong><a href="/diagnostico">Dívida vencida <span>→</span></a><a href="/diagnostico">Novo contrato <span>→</span></a><a href="/diagnostico">Terra irregular <span>→</span></a><a href="/diagnostico">Sucessão familiar <span>→</span></a></div></section>
<section class="live-radar-section"><div class="shell live-radar-head"><div><p class="eyebrow neon">JGG Agro Radar</p><h2>Informação jurídica<br /><em>para decisões no campo.</em></h2></div><div class="radar-status-card"><span class="radar-pulse"></span><div><strong>Curadoria ativa</strong><small>Última revisão: {radar[0].date}</small></div></div></div><div class="shell alert-grid">{latest.map((item, i) => <article class="alert-card info motion-card" style={`animation-delay:${i * 120}ms`}><div class="alert-card-top"><span class="alert-level">CONTEÚDO INFORMATIVO</span><time datetime={item.dateIso}>{item.date}</time></div><small>{item.category}</small><h3>{item.title}</h3><p>{item.summary}</p><a href={`/radar/${item.slug}`}>Ler análise e fontes <b>↗</b></a></article>)}</div><div class="shell radar-cta-row"><p><span>Revisado</span> Fontes oficiais, classificação temática e validação humana antes da publicação.</p><a href="/radar">Abrir o Radar completo →</a></div></section>
<section class="pain-section" id="solucoes"><div class="shell"><div class="section-heading conversion-heading"><p class="eyebrow">Comece pelo seu problema</p><h2>Você não precisa saber<br />qual área do Direito procurar.</h2><p>Escolha a situação mais parecida com a sua. A JGG conecta as áreas necessárias para construir a leitura jurídica do caso.</p></div><div class="pain-grid"><a href="/diagnostico" class="pain-card"><div class="pain-number">01</div><span class="pain-icon" aria-hidden="true">↘</span><h3>Minha dívida venceu</h3><p>CPR, CCB, execução, renegociação ou garantia sobre o patrimônio.</p><b>Avaliar exposição <i>→</i></b></a><a href="/diagnostico" class="pain-card"><div class="pain-number">02</div><span class="pain-icon" aria-hidden="true">⌁</span><h3>Vou assinar um contrato</h3><p>Arrendamento, parceria, compra de área ou nova operação bancária.</p><b>Ver pontos de atenção <i>→</i></b></a><a href="/diagnostico" class="pain-card"><div class="pain-number">03</div><span class="pain-icon" aria-hidden="true">◇</span><h3>Quero proteger o patrimônio</h3><p>Sucessão, holding, governança familiar e continuidade da operação.</p><b>Organizar o cenário <i>→</i></b></a><a href={wa('Olá! Recebi uma notificação e quero entender como organizar meu caso.')} class="pain-card"><div class="pain-number">04</div><span class="pain-icon" aria-hidden="true">!</span><h3>Recebi uma notificação</h3><p>Fiscalização, embargo, cobrança, citação ou exigência documental.</p><b>Entender o próximo passo <i>→</i></b></a></div></div></section>
<section class="diagnostic-stage"><div class="diagnostic-orbit" aria-hidden="true"></div><div class="shell diagnostic-grid"><div><p class="eyebrow neon">Triagem informativa</p><h2>Em poucos minutos, organize os pontos a conferir.</h2><p>A ferramenta reúne informações sobre dívida, contrato, garantias, terra e patrimônio. Não realiza consulta jurídica automática.</p><ul><li><span>01</span> Sem envio durante as perguntas</li><li><span>02</span> Panorama informativo</li><li><span>03</span> Revisão humana quando solicitada</li></ul><a href="/diagnostico" class="button electric">Iniciar triagem <span>→</span></a></div><div class="diagnostic-demo" aria-hidden="true"><div class="demo-head"><span>TRIAGEM DA OPERAÇÃO RURAL</span><b>02 / 05</b></div><div class="demo-progress"><i></i></div><small>GARANTIAS</small><h3>Você sabe exatamente quais bens estão vinculados ao banco?</h3><div class="demo-options"><span>Sim, tenho clareza</span><span class="selected">Sei apenas parte <b>✓</b></span><span>Não sei o que está vinculado</span></div><footer><span>Organização informativa das respostas</span><b>Próxima →</b></footer></div></div></section>
<section class="process-section" id="como-funciona"><div class="shell"><div class="section-heading process-heading"><div><p class="eyebrow">Como atuamos</p><h2>Clareza antes<br />de estratégia.</h2></div><p>Nenhuma solução pronta. O trabalho começa entendendo a operação, os documentos e o patrimônio envolvido.</p></div><div class="process-line"><article><span>01</span><div></div><h3>Leitura do cenário</h3><p>Organizamos fatos, documentos e urgências.</p></article><article><span>02</span><div></div><h3>Mapa de exposição</h3><p>Conectamos dívida, garantias, terra e patrimônio.</p></article><article><span>03</span><div></div><h3>Estratégia jurídica</h3><p>Indicamos caminhos possíveis para o caso concreto.</p></article></div></div></section>
<section class="authority-section" id="equipe"><div class="shell authority-grid"><div class="authority-visual"><Logo variant="stacked" class="authority-official-logo" /><div class="authority-badge"><b>Experiência consolidada</b><small>Atuação que atravessa ciclos do agro</small></div></div><div><p class="eyebrow light">JGG Group</p><h2>Experiência jurídica para decisões que não admitem improviso.</h2><p>Atuação integrada em Direito Agrário, Bancário, Tributário e Patrimonial, com presença no Paraná e em Mato Grosso.</p><div class="authority-names"><div><strong>Gilberto Jacob</strong><span>Sócio fundador · OAB/PR 17.158</span></div><div><strong>Felipe Ricardo Greczyszn</strong><span>Sócio · OAB/MT 31.081</span></div><div><strong>Reginaldo Greczyszn</strong><span>Sócio residente · Mato Grosso</span></div></div></div></div></section>
<section class="final-conversion" id="contato"><div class="shell"><div class="final-conversion-copy"><span class="signal" aria-hidden="true">●</span><p class="eyebrow neon">Seu próximo passo</p><h2>Antes de assinar,<br />renegociar ou esperar,<br /><em>entenda o seu cenário.</em></h2><p>Use o diagnóstico ou conte brevemente o que está acontecendo.</p></div><div class="final-actions"><a href="/diagnostico" class="button electric big">Fazer diagnóstico agora <span>→</span></a><a class="button outline big" href={wa('Olá! Quero organizar meu cenário jurídico com a JGG Group.')}>Falar com a equipe</a><small>Conteúdo e ferramentas de caráter informativo. Cada caso exige análise própria.</small></div></div></section>
<footer class="footer"><div class="shell footer-grid"><div><div class="footer-logo-panel"><Logo /></div><p>Direito Agrário, Bancário, Patrimonial e Tributário para o agronegócio.</p></div><div><h4>Navegação</h4><a href="#solucoes">Soluções</a><a href="/radar">Agro Radar</a><a href="/ferramentas">Ferramentas</a><a href="/diagnostico">Diagnóstico</a></div><div><h4>Presença</h4><p>Maringá — PR<br />Av. Euclides da Cunha, 526</p><p>Mato Grosso<br />Atuação em todo o estado</p></div><div><h4>Contato</h4><a href="mailto:contato@jgggroup.com.br">contato@jgggroup.com.br</a><a href="https://wa.me/5544988335397">WhatsApp</a><a href="https://www.linkedin.com/company/jgg-group">LinkedIn</a><p>OAB/PR 17.158</p></div></div><div class="shell footer-bottom"><span>© 2026 JGG Group</span><span>Conteúdo informativo. Não substitui análise jurídica.</span><a href="/privacidade">Privacidade</a></div></footer>
<div class="floating-conversion"><div><span class="radar-pulse"></span><p><strong>Tem uma decisão jurídica pela frente?</strong><small>Organize seu cenário antes do próximo passo.</small></p></div><a href="/diagnostico">Avaliar agora →</a><a href="tel:+5544988335397">Ligar</a></div>
</main>
<template id="exit-intent"><div class="exit-backdrop" role="presentation"><section class="exit-card" role="dialog" aria-modal="true" aria-labelledby="exit-title"><button type="button" aria-label="Fechar">×</button><p class="eyebrow">Antes de sair</p><h2 id="exit-title">Leve um panorama do seu cenário.</h2><p>Responda cinco perguntas e gere um relatório informativo em PDF para organizar os próximos pontos.</p><a class="button electric" href="/diagnostico">Fazer diagnóstico →</a></section></div></template>
</Base>

<script>
  // Orientador de cenário
  const answer = document.querySelector<HTMLElement>('[data-risk-answer]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.risk-chips button')];
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chips.forEach((c) => { c.classList.toggle('active', c === chip); c.setAttribute('aria-pressed', String(c === chip)); });
      if (answer) answer.textContent = chip.dataset.answer ?? '';
    }),
  );

  // Hero personalizado por ?persona= ou ?origem= (pr, mt, empresa)
  const personas = {
    pr: { kicker: 'Paraná', title: 'Organize as informações jurídicas da sua <em>operação rural no Paraná.</em>', text: 'Crédito, terra, contratos, tributos e sucessão exigem uma leitura conjunta e conectada à realidade da operação paranaense.' },
    mt: { kicker: 'Mato Grosso', title: 'Clareza jurídica para decisões da <em>operação rural em Mato Grosso.</em>', text: 'Contratos, crédito, terra e patrimônio precisam acompanhar a escala e a velocidade das decisões no centro do agro.' },
    empresa: { kicker: 'Empresas do agro', title: 'Governança jurídica para a <em>próxima decisão empresarial.</em>', text: 'Operação, contratos, tributos e patrimônio exigem organização integrada e análise profissional.' },
  };
  const params = new URLSearchParams(location.search);
  const p = (params.get('persona') || params.get('origem') || '').toLowerCase();
  const key = p.includes('parana') || p === 'pr' ? 'pr' : p.includes('mato') || p === 'mt' ? 'mt' : p.includes('empresa') || p.includes('b2b') ? 'empresa' : null;
  const title = document.querySelector<HTMLElement>('[data-hero-title]');
  const text = document.querySelector<HTMLElement>('[data-hero-text]');
  if (key && title && text) {
    const v = personas[key];
    title.insertAdjacentHTML('beforebegin', `<small class="hero-persona">Conteúdo para ${v.kicker}</small>`);
    title.innerHTML = v.title;
    text.textContent = v.text;
  }

  // Convite ao sair (só desktop, uma vez por sessão, após 18 s)
  if (!matchMedia('(max-width: 900px)').matches && !sessionStorage.getItem('jgg-exit-seen')) {
    const tpl = document.getElementById('exit-intent') as HTMLTemplateElement | null;
    const onOut = (e: MouseEvent) => {
      if (e.clientY > 8 || !tpl) return;
      document.removeEventListener('mouseout', onOut);
      sessionStorage.setItem('jgg-exit-seen', '1');
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const close = () => { node.remove(); document.removeEventListener('keydown', onKey); };
      const onKey = (k: KeyboardEvent) => k.key === 'Escape' && close();
      node.addEventListener('mousedown', (ev) => ev.target === node && close());
      node.querySelector('button')!.addEventListener('click', close);
      document.addEventListener('keydown', onKey);
      document.body.append(node);
      node.querySelector<HTMLElement>('a')?.focus();
    };
    setTimeout(() => document.addEventListener('mouseout', onOut), 18000);
  }
</script>
